# ============================================================
# SovereignAI Workbench - Environment Configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ============================================================

# --- Application ---
APP_NAME=SovereignAI Workbench
ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL in Docker; SQLite for local dev) ---
# Local dev (default):
DATABASE_URL=sqlite:///./data/sovereignai.db
# Docker Compose (uncomment):
# DATABASE_URL=postgresql+psycopg2://sovereign:sovereign@db:5432/sovereignai

# --- Storage ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
VECTOR_DB_PATH=./data/chroma
SAMPLE_DIR=./backend/samples

# --- Upload limits & security ---
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg

# Optional API access token. If set, every API call must send:
#   Authorization: Bearer <ACCESS_TOKEN>
# Leave empty to run without authentication (local/trusted networks only).
ACCESS_TOKEN=

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173

# ============================================================
# LLM Configuration - LOCAL-ONLY / OFFLINE-FIRST
# No cloud AI API is ever called. The backend never phones home.
# ============================================================
# Provider: auto | builtin | mock | ollama | openai-compatible
#   auto   -> built-in grounded engine unless OPENAI_BASE_URL points at a
#             LOCAL endpoint (then that local server is used)
#   builtin / mock -> always the built-in grounded/extractive engine, which
#             answers only from retrieved document text (fully offline demo)
#   ollama -> local Ollama server (defaults to http://127.0.0.1:11434/v1)
#   openai-compatible -> any LOCAL OpenAI-compatible server
#             (Ollama, vLLM, LM Studio, llama.cpp), requires OPENAI_BASE_URL
#
# OPENAI_BASE_URL must be a loopback address (localhost/127.x/::1). Remote
# hosts are refused unless ALLOW_REMOTE_LLM=true (explicit opt-in).
LLM_PROVIDER=auto
LLM_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=
ALLOW_REMOTE_LLM=false

# Example for a local Ollama server:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1:8b
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ============================================================
# Embeddings (local / sovereign by default - never an external API)
# ============================================================
# Provider: auto | chroma | hash
#   auto   -> ONNX all-MiniLM-L6-v2 when cached locally, else hash fallback
#   chroma -> same ONNX model; errors clearly if not provisioned locally
#   hash   -> deterministic hashing embeddings (zero model, fully offline)
#
# The ONNX model is never downloaded at runtime. Provision it once while
# online with:  python backend/scripts/embed_setup.py
# (the Docker image bakes it in at build time).
EMBEDDINGS_PROVIDER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chroma telemetry (PostHog) is always disabled by the backend; keep this
# explicit in case Chroma is used outside the app.
ANONYMIZED_TELEMETRY=false

# ============================================================
# OCR (Tesseract - local)
# ============================================================
OCR_LANG=eng
OCR_DPI=220

# ============================================================
# RAG
# ============================================================
RAG_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# ============================================================
# Sandbox
# ============================================================
# Executor: subprocess (default) | docker (real isolation, needs Docker CLI)
SANDBOX_EXECUTOR=subprocess
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_MB=256
